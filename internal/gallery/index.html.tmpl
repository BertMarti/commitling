<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
<link rel="canonical" href="{{.SiteURL}}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="commitling">
<meta property="og:locale" content="es_ES">
<meta property="og:title" content="{{.Title}}">
<meta property="og:description" content="{{.Description}}">
<meta property="og:url" content="{{.SiteURL}}">
<meta property="og:image" content="{{.OGImage}}">
<meta property="og:image:alt" content="commitling: un retoño pixel-art con una flor y, debajo del nombre, las cinco fases de cada una de las dos especies, el brote de musgo y el hongo">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{.Favicon}}" type="image/svg+xml">
<style>
:root{
  --paper:#f3efe6;--ink:#2b2724;--line:#ddd5c6;--muted:#6b6259;
  --moss:#7fb069;--honey:#e6aa68;--accent:#b8341f;--code:#ebe5d8;
  color-scheme:light dark;
}
@media (prefers-color-scheme:dark){
  :root{--paper:#2b2724;--ink:#f3efe6;--line:#4a433d;--muted:#a39a8e;--accent:#ee6e55;--code:#34302c}
}
*{box-sizing:border-box}
html{background:var(--paper)}
body{margin:0;background:var(--paper);color:var(--ink);
  font:15px/1.7 ui-monospace,SFMono-Regular,Menlo,Consolas,"DejaVu Sans Mono","Liberation Mono",monospace}
main,header,footer{max-width:1000px;margin:0 auto;padding:0 20px}
a{color:inherit;text-decoration-color:var(--accent);text-underline-offset:3px;text-decoration-thickness:2px}
a:hover{color:var(--accent)}
:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.skip{position:absolute;left:-9999px;top:8px;padding:6px 12px;background:var(--paper);color:var(--ink);border:2px solid var(--ink);z-index:1}
.skip:focus{left:8px}
.jump{display:block;margin:0 0 6px;font-size:14px}
header{padding-top:64px;padding-bottom:48px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,480px);gap:28px 48px;align-items:center}
.hero img{display:block;width:100%;height:auto}
h1{font-size:34px;line-height:1.1;margin:0 0 10px;letter-spacing:-.02em}
h2{font-size:13px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 20px;color:var(--muted);font-weight:600}
h3{font-size:16px;margin:36px 0 14px}
h3.species{font-size:20px;margin:56px 0 8px;padding-top:28px;border-top:2px dashed var(--line)}
h3.species:first-of-type{margin-top:32px;padding-top:0;border-top:0}
h4{font-size:15px;margin:32px 0 14px}
p{margin:0 0 14px;max-width:68ch}
.lead{font-size:17px;margin:0}
nav{margin-top:14px;display:flex;flex-wrap:wrap;gap:6px 18px;font-size:14px}
section{padding:56px 0;border-top:2px dashed var(--line)}
.gen{display:grid;grid-template-columns:minmax(0,320px) minmax(0,1fr);gap:28px 40px;align-items:start}
.gen-form{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
.gen-form label.f,.gen-form legend{display:block;font-weight:700;padding:0;margin:0 0 6px}
.gen-form fieldset{border:0;margin:0;padding:0;min-width:0}
.gen-form input[type=text]{display:block;width:100%;font:inherit;font-size:16px;padding:9px 12px;background:var(--paper);color:var(--ink);border:2px solid var(--ink);border-radius:0}
.gen-form input[type=text]::placeholder{color:var(--muted);opacity:1}
.opts{display:flex;flex-wrap:wrap;gap:8px}
.opt{position:relative}
.opt input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
.opt label{display:block;padding:6px 14px;border:2px solid var(--ink);background:var(--paper)}
.opt input:checked+label{background:var(--ink);color:var(--paper)}
.opt input:focus-visible+label{outline:2px solid var(--accent);outline-offset:3px}
.go{justify-self:start;font:inherit;font-weight:700;padding:10px 22px;cursor:pointer;background:var(--moss);color:#2b2724;border:2px solid var(--ink);border-radius:0}
.go:hover{background:var(--honey)}
.go[aria-disabled=true]{cursor:progress;background:var(--code);color:var(--muted)}
.gen-msgs p{margin:0}
.gen-error{color:var(--accent);font-weight:700}
.gen-stage{margin:0;display:grid;grid-template-columns:minmax(0,1fr);gap:10px;align-content:start}
.gen-stage img{display:block;width:100%;max-width:480px;height:auto;aspect-ratio:12/5}
.gen-stage img[hidden],.gen-empty[hidden]{display:none}
.gen-stage[data-size=compact] img{max-width:200px;aspect-ratio:10/3}
.gen-stage[data-size=compact] .gen-empty{max-width:200px;aspect-ratio:10/3;padding:6px;font-size:12px;line-height:1.4}
.gen-empty{margin:0;width:100%;max-width:480px;aspect-ratio:12/5;padding:12px;display:grid;grid-template-columns:minmax(0,1fr);place-items:center;text-align:center;color:var(--muted);border:1px solid var(--line);border-radius:8px}
.gen-view{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;min-width:0}
.demo{display:grid;grid-template-columns:minmax(0,1fr);gap:10px}
.demo-t{margin:0;font-size:14px}
.demo-bar{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.demo-bar .go{padding:8px 16px}
.go.alt{background:var(--paper);color:var(--ink)}
.go.alt:hover{background:var(--honey);color:#2b2724}
.go:disabled,.go:disabled:hover{cursor:not-allowed;background:var(--code);color:var(--muted)}
.demo-day{margin-left:auto;font-weight:700}
.demo-slider{display:grid;grid-template-columns:minmax(0,1fr);gap:4px}
.demo-slider[hidden]{display:none}
.demo-slider label{font-weight:700}
.demo-slider input{width:100%;accent-color:var(--moss)}
.demo-phase{margin:0;min-height:1.7em;font-weight:700}
.cta{margin:18px 0 0}
.cta .go[hidden]{display:none}
.gen-after{grid-column:1/-1}
.gen-after h3{margin-top:0}
a.go,a.go:hover{display:inline-block;text-decoration:none;color:#2b2724}
.gen-stage figcaption{margin:0;max-width:480px;width:100%}
.live{display:grid;grid-template-columns:minmax(0,1fr);justify-items:start;gap:12px}
.live img,.grid img{display:block;width:100%;max-width:480px;height:auto}
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(200px,100%),1fr));gap:18px 24px}
.badges img{display:block;width:100%;max-width:200px;height:auto}
.note{font-size:13px;color:var(--muted)}
.steps{counter-reset:s;list-style:none;padding:0;margin:0;display:grid;grid-template-columns:minmax(0,1fr);gap:14px;max-width:72ch}
.steps li{counter-increment:s;padding-left:44px;position:relative;min-width:0}
.steps li::before{content:counter(s);position:absolute;left:0;top:1px;width:28px;height:28px;display:grid;place-items:center;
  background:var(--moss);color:#2b2724;font-weight:700;font-size:13px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 24px}
figure{margin:0}
figcaption{font-size:13px;color:var(--muted);margin-top:8px}
.tables{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 40px}
table{border-collapse:collapse;width:100%;font-size:14px}
caption{text-align:left;font-weight:700;padding-bottom:8px}
td{padding:7px 0;border-bottom:1px solid var(--line);vertical-align:top}
td:first-child{padding-right:16px;white-space:nowrap}
td:last-child{color:var(--muted)}
.xp td:first-child{white-space:normal}
.xp td:last-child{white-space:nowrap;text-align:right}
.code{position:relative;margin:10px 0 22px}
pre{margin:0;padding:18px 20px;background:var(--code);overflow-x:auto;font-size:13px;line-height:1.6;border-left:4px solid var(--moss)}
code{font-family:inherit}
p code,li code,td code{background:var(--code);padding:1px 5px;overflow-wrap:anywhere}
pre code,li pre code{background:none;padding:0}
.copy{position:absolute;top:10px;right:10px;font:inherit;font-size:12px;padding:4px 10px;cursor:pointer;
  background:var(--paper);color:var(--ink);border:1px solid var(--line)}
.copy:hover{border-color:var(--ink)}
.copy[hidden]{display:none}
.copy-msg{margin:6px 0 0}
.copy-msg:empty{margin:0}
footer{padding-top:40px;padding-bottom:64px;border-top:2px dashed var(--line);font-size:13px;color:var(--muted)}
footer p{max-width:none}
@media (max-width:860px){
  header{grid-template-columns:minmax(0,1fr);padding-top:32px;gap:24px}
  .hero{order:-1}
}
@media (max-width:720px){
  h1{font-size:28px}
  .grid,.tables{grid-template-columns:minmax(0,1fr)}
  .gen{grid-template-columns:minmax(0,1fr)}
  section{padding:40px 0}
  td:first-child{white-space:normal}
}
</style>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header>
  <div class="intro">
    <h1>commitling</h1>
    <p class="lead">Una mascota pixel-art que vive en el README de tu perfil de GitHub y crece con tus commits.</p>
    <p class="cta"><a class="go" href="#generador" id="hero-demo" hidden>Ver demo: míralo crecer</a></p>
    <nav aria-label="Secciones">
      <a href="#generador">Pruébalo</a>
      <a href="#vivo">En vivo</a>
      <a href="#galeria">Galería</a>
      <a href="#reglas">Reglas</a>
      <a href="#instalar">Instalar</a>
      <a href="https://github.com/BertMarti/commitling">Código</a>
    </nav>
  </div>
  <picture class="hero">
    <source media="(prefers-color-scheme: dark)" srcset="{{.Hero.Dark}}">
    <img src="{{.Hero.Light}}" width="480" height="200" alt="{{.Hero.Alt}}">
  </picture>
</header>
<main id="contenido">
  <section id="generador" aria-labelledby="generador-t">
    <h2 id="generador-t">Pruébalo con tu usuario</h2>
    <p>Escribe tu usuario de GitHub y mira tu criatura al momento. Se dibuja en tu navegador con el mismo código que la Action; lo único que sale de tu ordenador es la petición pública a GitHub (hasta 60 por hora y por conexión).</p>
    <noscript><p class="note">El generador necesita JavaScript. Sin él puedes ver la galería de abajo o instalar la Action.</p></noscript>
    <div class="gen" id="gen" hidden>
      <form id="gen-form" class="gen-form" novalidate>
        <div>
          <label class="f" for="gen-user">Usuario de GitHub</label>
          <input type="text" id="gen-user" name="user" maxlength="40" placeholder="BertMarti" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" aria-describedby="gen-hint gen-error">
          <p id="gen-hint" class="note" style="margin:6px 0 0">Solo se usa tu actividad pública de los últimos 90 días.</p>
        </div>
        <fieldset>
          <legend>Especie</legend>
          <div class="opts">{{range $i, $c := .GenSpecies}}
            <div class="opt"><input type="radio" name="species" value="{{$c.Value}}" id="gen-sp-{{$c.Value}}"{{if eq $i 0}} checked{{end}}><label for="gen-sp-{{$c.Value}}">{{$c.Label}}</label></div>{{end}}
          </div>
        </fieldset>
        <fieldset>
          <legend>Tema</legend>
          <div class="opts">
            <div class="opt"><input type="radio" name="theme" value="light" id="gen-th-light" checked><label for="gen-th-light">Claro</label></div>
            <div class="opt"><input type="radio" name="theme" value="dark" id="gen-th-dark"><label for="gen-th-dark">Oscuro</label></div>
          </div>
        </fieldset>
        <fieldset>
          <legend>Tamaño</legend>
          <div class="opts">{{range $i, $c := .GenSizes}}
            <div class="opt"><input type="radio" name="size" value="{{$c.Value}}" id="gen-sz-{{$c.Value}}"{{if eq $i 0}} checked{{end}}><label for="gen-sz-{{$c.Value}}">{{$c.Label}}</label></div>{{end}}
          </div>
        </fieldset>
        <button type="submit" class="go" id="gen-go">Dibujar</button>
        <div class="gen-msgs">
          <p id="gen-status" class="note" role="status"></p>
          <p id="gen-error" class="gen-error" role="alert"></p>
        </div>
      </form>
      <div class="gen-view">
        <figure class="gen-stage" id="gen-stage" data-size="full">
          <p class="gen-empty" id="gen-empty">Tu criatura aparecerá aquí.</p>
          <img id="gen-img" width="480" height="200" alt="" hidden>
          <figcaption class="note" id="gen-caption"></figcaption>
        </figure>
        <div class="demo" role="group" aria-labelledby="demo-t">
          <p class="demo-t" id="demo-t">¿Sin usuario a mano? Mira cómo crece una criatura de ejemplo (90 días en 15 segundos, sin pedir nada a GitHub).</p>
          <div class="demo-bar">
            <button type="button" class="go" id="demo-go">Ver demo</button>
            <button type="button" class="go alt" id="demo-pause" disabled>Pausa</button>
            <button type="button" class="go alt" id="demo-stop" disabled>Detener</button>
            <span class="demo-day" id="demo-day" aria-hidden="true"></span>
          </div>
          <div class="demo-slider" id="demo-slider" hidden>
            <label for="demo-range">Día de la demo</label>
            <input type="range" id="demo-range" min="0" max="90" value="0" step="1">
          </div>
          <p class="note demo-phase" id="demo-phase" role="status" aria-live="polite"></p>
        </div>
      </div>
      <div class="gen-after" id="gen-after" hidden>
        <p><a class="go" id="gen-dl" download="commitling.svg" href="#">Descargar SVG</a></p>
        <h3>Tu workflow</h3>
        <p class="note">Guárdalo como <code>.github/workflows/commitling.yml</code> en tu repositorio de perfil (<code>tu-usuario/tu-usuario</code>) y sigue los pasos de <a href="#instalar">Instálalo en tu perfil</a>. Ya lleva tu usuario y lo que has elegido arriba.</p>
        <div class="code"><button class="copy" type="button" data-copy="gen-wf" aria-label="Copiar el workflow con tu usuario" hidden>Copiar</button><pre tabindex="0" aria-label="Workflow con tu usuario"><code id="gen-wf"></code></pre><p class="copy-msg note" role="status" aria-live="polite"></p></div>
      </div>
    </div>
  </section>

  <section id="vivo" aria-labelledby="vivo-t">
    <h2 id="vivo-t">En vivo</h2>
    <div class="live">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="live/{{.LiveUser}}-dark.svg">
        <img src="live/{{.LiveUser}}.svg" width="480" height="200" alt="La criatura de @{{.LiveUser}}, generada con su actividad pública en GitHub" onerror="this.closest('.live').querySelector('.missing').hidden=false;this.closest('picture').hidden=true">
      </picture>
      <p class="note">La criatura de <a href="https://github.com/{{.LiveUser}}">@{{.LiveUser}}</a>, regenerada cada día con su actividad pública.</p>
      <p class="note missing" hidden>La criatura en vivo aún no está disponible; se genera en el despliegue diario.</p>
    </div>
  </section>

  <section id="como" aria-labelledby="como-t">
    <h2 id="como-t">Cómo funciona</h2>
    <ol class="steps">
      <li>Una GitHub Action lee tu actividad <strong>pública</strong> de los últimos 90 días: commits, pull requests, issues y el resto de eventos.</li>
      <li>Calcula tu experiencia, tu racha de días seguidos y tus días activos. Los días se cuentan en UTC.</li>
      <li>Dibuja un SVG animado: la criatura crece por fases, cambia de ánimo según tu actividad reciente y desbloquea accesorios.</li>
      <li>Tu workflow guarda el SVG en tu repositorio de perfil solo si ha cambiado. Mismos datos, mismo dibujo.</li>
    </ol>
  </section>

  <section id="galeria" aria-labelledby="galeria-t">
    <h2 id="galeria-t">Galería</h2>
    <p>Todas las especies, fases y ánimos, dibujados con estadísticas de ejemplo de un usuario ficticio. La especie se elige con la entrada <code>species</code> de la Action (o <code>--species</code> en la línea de órdenes); si no la indicas, sale el brote de musgo.</p>
    <nav class="jump" aria-label="Especies">Ir a: {{range $i, $s := .Species}}{{if $i}} · {{end}}<a href="#especie-{{$s.ID}}">{{$s.Name}}</a>{{end}} · <a href="#compacta">Tarjeta compacta</a></nav>
    {{range .Species}}
    <h3 class="species" id="especie-{{.ID}}">{{.Name}}</h3>
    <p class="note">{{.Intro}}</p>
    {{range .Rows}}
    <h4>{{.Title}}</h4>
    <div class="grid">
      {{range .Figures}}
      <figure>
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="{{.Dark}}">
          <img src="{{.Light}}" width="480" height="200" loading="lazy" alt="{{.Alt}}">
        </picture>
        <figcaption>{{.Caption}}</figcaption>
      </figure>
      {{end}}
    </div>
    {{end}}
    <h4 id="accesorios-{{.ID}}">Accesorios · {{.Name}}</h4>
    <div class="grid">
      {{range .Extras}}
      <figure>
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="{{.Dark}}">
          <img src="{{.Light}}" width="480" height="200" loading="lazy" alt="{{.Alt}}">
        </picture>
        <figcaption>{{.Caption}}</figcaption>
      </figure>
      {{end}}
    </div>
    {{end}}
    <h3 class="species" id="compacta">Tarjeta compacta</h3>
    <p>Una insignia de 200x60 con la criatura, su fase, su ánimo y una barra de progreso, para firmas, barras laterales o la cabecera de un repositorio. Se pide con <code>size: compact</code> en la Action (o <code>--size compact</code> en la línea de órdenes); sin ella sale la tarjeta de siempre. Mismos dibujos, misma paleta y misma animación.</p>
    {{range .Badges}}
    <h4>{{.Name}}</h4>
    <div class="badges">
      {{range .Figures}}
      <figure>
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="{{.Dark}}">
          <img src="{{.Light}}" width="200" height="60" loading="lazy" alt="{{.Alt}}">
        </picture>
      </figure>
      {{end}}
    </div>
    {{end}}
  </section>

  <section id="reglas" aria-labelledby="reglas-t">
    <h2 id="reglas-t">Reglas</h2>
    <p>Son deterministas: con los mismos datos, la criatura es siempre la misma.</p>
    <div class="tables">
      <table class="xp">
        <caption>Experiencia</caption>
        <tbody>{{range .XP}}<tr><td>{{.Name}}</td><td>{{.When}}</td></tr>{{end}}</tbody>
      </table>
      <table>
        <caption>Fases</caption>
        <tbody>{{range .Stages}}<tr><td>{{.Name}}</td><td>{{.When}}</td></tr>{{end}}</tbody>
      </table>
      <table>
        <caption>Ánimos</caption>
        <tbody>{{range .Moods}}<tr><td>{{.Name}}</td><td>{{.When}}</td></tr>{{end}}</tbody>
      </table>
      <table>
        <caption>Accesorios</caption>
        <tbody>{{range .Acc}}<tr><td>{{.Name}}</td><td>{{.When}}</td></tr>{{end}}</tbody>
      </table>
    </div>
    <p class="note" style="margin-top:22px">La racha cuenta días seguidos con actividad y se mantiene hasta el final del día siguiente, así no se rompe por la mañana antes de tu primer commit. Si GitHub no indica cuántos commits lleva un push, cuenta como uno.</p>
  </section>

  <section id="instalar" aria-labelledby="instalar-t">
    <h2 id="instalar-t">Instálalo en tu perfil</h2>
    <ol class="steps">
      <li>Abre (o crea) tu repositorio de perfil: el que se llama igual que tu usuario, <code>tu-usuario/tu-usuario</code>.</li>
      <li>Crea el archivo <code>.github/workflows/commitling.yml</code> con este contenido:
        <div class="code"><button class="copy" type="button" data-copy="wf" aria-label="Copiar el workflow" hidden>Copiar</button><pre tabindex="0" aria-label="Contenido del workflow"><code id="wf">{{.Workflow}}</code></pre><p class="copy-msg note" role="status" aria-live="polite"></p></div>
      </li>
      <li>Añade la criatura a tu <code>README.md</code>:
        <div class="code"><button class="copy" type="button" data-copy="rd" aria-label="Copiar la línea del README" hidden>Copiar</button><pre tabindex="0" aria-label="Línea para el README"><code id="rd">{{.Readme}}</code></pre><p class="copy-msg note" role="status" aria-live="polite"></p></div>
      </li>
      <li>Ve a la pestaña <strong>Actions</strong>, elige «commitling» y pulsa <strong>Run workflow</strong>. Después se actualizará sola cada día.</li>
    </ol>
    <h3>Opcional: tema oscuro</h3>
    <p>Añade un segundo paso con <code>theme: dark</code> y <code>out: commitling-dark.svg</code> (y súmalo al <code>git add</code>), y usa esto en el README para que GitHub elija según el tema de quien lo mira:</p>
    <div class="code"><button class="copy" type="button" data-copy="rdd" aria-label="Copiar el fragmento del README con tema oscuro" hidden>Copiar</button><pre tabindex="0" aria-label="Fragmento del README con tema oscuro"><code id="rdd">{{.ReadmeDrk}}</code></pre><p class="copy-msg note" role="status" aria-live="polite"></p></div>
  </section>

  <section id="privacidad" aria-labelledby="privacidad-t">
    <h2 id="privacidad-t">Privacidad</h2>
    <p>commitling solo usa la API pública de eventos de GitHub: lo mismo que cualquiera puede ver en tu perfil. No lee repositorios privados, no guarda nada fuera de tu repositorio y no necesita más permisos que el <code>GITHUB_TOKEN</code> de tu propio workflow.</p>
  </section>
</main>
<footer>
  <p>commitling {{.Version}} · licencia MIT · <a href="https://github.com/BertMarti/commitling">github.com/BertMarti/commitling</a></p>
  <p>Construido por un equipo de agentes de IA (Claude Code y OpenCode) supervisado por Alberto. La criatura es un diseño original.</p>
</footer>
<script>
document.querySelectorAll('.copy').forEach(function (b) {
  var box = b.closest('.code');
  var msg = box.querySelector('.copy-msg');
  var code = document.getElementById(b.dataset.copy);
  function say(text) { msg.textContent = text; }
  function select() {
    var range = document.createRange();
    range.selectNodeContents(code);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
  function done() {
    b.textContent = 'Copiado';
    say('Copiado al portapapeles.');
    setTimeout(function () { b.textContent = 'Copiar'; say(''); }, 2000);
  }
  function failed() {
    select();
    say('No se pudo copiar automáticamente. El texto está seleccionado: cópialo con Ctrl+C (o Cmd+C).');
  }
  b.hidden = false;
  b.addEventListener('click', function () {
    var text = code.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, failed);
      return;
    }
    select();
    try { document.execCommand('copy') ? done() : failed(); } catch (e) { failed(); }
  });
});
</script>
